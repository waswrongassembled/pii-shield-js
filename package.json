{
  "name": "@waswrongassembled/pii-shield",
  "version": "0.3.0",
  "description": "Reversible PII redaction for LLM applications with DACH recognizers (AT SVNR, IBAN, tax numbers) and checksum validation. Wire-compatible port of clarifile/pii-shield.",
  "license": "MIT",
  "author": {
    "name": "waswrongassembled",
    "url": "https://github.com/waswrongassembled"
  },
  "type": "module",
  "keywords": [
    "pii",
    "gdpr",
    "dsgvo",
    "redaction",
    "anonymization",
    "pseudonymization",
    "privacy",
    "llm",
    "ai-sdk",
    "mcp",
    "iban",
    "dach",
    "postgres"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waswrongassembled/pii-shield-js.git"
  },
  "homepage": "https://github.com/waswrongassembled/pii-shield-js#readme",
  "bugs": {
    "url": "https://github.com/waswrongassembled/pii-shield-js/issues"
  },
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vault-redis": {
      "types": "./dist/vault-redis/index.d.ts",
      "default": "./dist/vault-redis/index.js"
    },
    "./ai-sdk": {
      "types": "./dist/ai-sdk/index.d.ts",
      "default": "./dist/ai-sdk/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "default": "./dist/mcp/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres/index.d.ts",
      "default": "./dist/postgres/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "pii-shield": "dist/bin.js"
  },
  "files": [
    "dist",
    "docs/openapi.yaml",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node -e \"fs.chmodSync('dist/bin.js', 0o755)\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:package": "npm run build && publint --strict && attw --pack . --profile esm-only",
    "test:package": "npm run build && node scripts/test-package.js",
    "fixtures": "php compat/export-fixtures.php",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "compat:vault": "npm run build && node compat/export-node-payloads.js",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^22.20.5",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "^5.1.1",
    "ai": "^7.0.177",
    "ajv": "^8.20.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "ioredis": "^6.0.0",
    "pg": "8.23.1",
    "prettier": "^3.10.1",
    "publint": "^0.3.25",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "ai": "^7.0.0",
    "ioredis": "^5.0.0 || ^6.0.0",
    "pg": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  }
}
